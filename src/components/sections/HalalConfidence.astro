---
// Scene — Halal, with confidence. Homepage replacement for the HalalPromise pillar grid.
// Editorial statement + a serif definition list (no numbered cards). Halal as operational
// discipline, not decoration. The shared HalalPromise.astro stays for the About page.
interface Props { scene?: string }
const { scene = "deep" } = Astro.props;
const commitments = [
  { term: "Certified, not claimed.", body: "A current certificate from an accredited authority on every range. The body, the audit cadence and the standard are named on request." },
  { term: "Traceable to source.", body: "Lot-level traceability from approved suppliers to the cabinet your buyer opens. No grey zones, no exceptions." },
  { term: "Audited continuously.", body: "HACCP, IFS, BRC and ISO frameworks are not badges. They are how the floor runs, every shift." },
];
---

<section id="halal" class="scene halal2" data-scene={scene} aria-labelledby="halal2-title">
  <div class={`grain${scene === "light" ? " grain--dark" : ""}`} aria-hidden="true"></div>
  <div class="container-x halal2__grid grid-ed grid-ed--5-7">
    <div class="halal2__statement">
      <h2 id="halal2-title" class="halal2__title text-display">
        A standard a buyer can defend in a tender.
      </h2>
      <p class="halal2__lede ink-dim">
        We do not ask anyone to take our word for it. The halal commitment is documentary,
        auditable, and present on every label.
      </p>
      <a href="#certifications" class={`btn halal2__cta ${scene === "light" ? "btn-secondary" : "btn-secondary-light"}`}>See the certifications</a>

      <svg class="halal2__mark" viewBox="0 0 200 200" aria-hidden="true">
        <circle cx="100" cy="100" r="86" fill="none" stroke="var(--scene-accent)" stroke-width="1" opacity="0.5" />
        <circle cx="100" cy="100" r="68" fill="none" stroke="var(--scene-accent)" stroke-width="1" stroke-dasharray="2 7" opacity="0.5" />
        <path d="M122 58 A52 52 0 1 0 122 142 A41 41 0 1 1 122 58 Z" fill="var(--scene-accent)" opacity="0.85"/>
      </svg>
    </div>

    <dl class="halal2__list">
      {commitments.map((c) => (
        <div class="halal2__item" data-reveal>
          <span class="halal2__tick" aria-hidden="true"></span>
          <dt class="halal2__term">{c.term}</dt>
          <dd class="halal2__body ink-dim">{c.body}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../lib/motion";
  revealOnScroll(document.querySelectorAll(".halal2 [data-reveal]"), { y: 22, stagger: 0.1 });
</script>

<style>
  .halal2 { --scene-pad: clamp(2.75rem, 6vw, 4.5rem); }
  .halal2__grid { align-items: start; }

  .halal2__statement { position: relative; }
  .halal2__title {
    color: var(--scene-title, var(--scene-ink));
    margin-block-start: 0.6rem;
    max-inline-size: 14ch;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
  }
  .halal2__lede { margin-block-start: 1.25rem; max-inline-size: 42ch; font-size: var(--text-body-lg); line-height: 1.6; }
  .halal2__cta { margin-block-start: 1.75rem; }
  .halal2__mark {
    position: absolute;
    inset-block-end: -0.5rem;
    inset-inline-end: 0;
    inline-size: clamp(90px, 12vw, 150px);
    opacity: 0.6;
  }
  @media (max-width: 879px) { .halal2__mark { display: none; } }

  .halal2__list { margin: 0; padding: 0; display: flex; flex-direction: column; }
  .halal2__item {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 1rem;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block-start: 1px solid var(--scene-line);
  }
  .halal2__item:first-child { border-block-start: 0; padding-block-start: 0; }
  .halal2__tick {
    grid-row: 1 / 3;
    inline-size: 10px; block-size: 10px;
    margin-block-start: 0.55rem;
    border-radius: 99px;
    background: var(--scene-accent);
  }
  .halal2__term {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--scene-title, var(--scene-ink));
  }
  .halal2__body { margin: 0.5rem 0 0; grid-column: 2; max-inline-size: 52ch; line-height: 1.6; }
</style>
