---
// Hero with a self-hosted MP4 background. No YouTube, no IFrame API, no controls.
// Drop a replacement at /public/videos/hero.mp4 and the page picks it up automatically.
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <video
      class="hero__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/images/hero/field.webp"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero__veil"></div>
    <div class="hero__grain"></div>
  </div>

  <div class="container-x hero__inner">
    <p class="eyebrow eyebrow--bone hero__eyebrow">
      Halal foods, made in the Netherlands. Shipped across Europe.
    </p>

    <h1 id="hero-title" class="hero__title">
      Halal, perfected.<br />
      Built for the buyers <br class="hero__br-hide" />who can&rsquo;t miss.
    </h1>

    <p class="hero__lede">
      Premium halal frozen foods. Chicken, beef and snack ranges produced to retail-grade specifications,
      certified for halal, and shipped pallet-ready to distributors, retailers and HoReCa partners across Europe.
    </p>

    <div class="hero__cta">
      <a href="/distributors/" class="btn btn-primary hero__btn-primary">
        Become a distributor
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="/products/" class="btn btn-secondary-light hero__btn-secondary">Browse the range</a>
    </div>

    <div class="hero__meta">
      <a href="#categories" class="hero__scroll" aria-label="Scroll to next section">
        <span class="hero__scroll-dot"></span>
        <span>Scroll</span>
      </a>
      <ul class="hero__chips" aria-label="Quick facts">
        <li><strong>3</strong> ranges</li>
        <li><strong>40+</strong> SKUs</li>
        <li><strong>Halal</strong> certified</li>
        <li><strong>EU-wide</strong> distribution</li>
      </ul>
    </div>
  </div>

  <div class="hero__divider" aria-hidden="true">
    <svg viewBox="0 0 1440 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,90 L0,60 C240,12 480,12 720,40 C960,68 1200,68 1440,30 L1440,90 Z" fill="var(--color-bone)" />
    </svg>
  </div>
</section>
