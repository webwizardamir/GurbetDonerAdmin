---
// Scene — Export confidence CTA. A climactic dark push: bold statement on the left, the ask and
// actions on the right (fills the width), and the working process as a single inline flow below.
import { site } from "../../lib/site";

const flow = [
  { phase: "Tell us your market", note: "Country, channels, approximate volume" },
  { phase: "We propose a range", note: "Range, indicative pricing, lead times" },
  { phase: "Sample & certify", note: "Sample box, certificates, technical sheets" },
];
---

<section id="distributors" class="scene xcta" data-scene="light" aria-labelledby="xcta-title">
  <div class="grain grain--dark" aria-hidden="true"></div>
  <div class="container-x">
    <div class="scene-panel scene-panel--deep xcta__panel">
      <div class="xcta__top grid-ed grid-ed--7-5">
        <div class="xcta__lead">
          <h2 id="xcta-title" class="xcta__title">Already exporting? Add a halal range that moves.</h2>
        </div>
        <div class="xcta__side">
          <p class="xcta__sub ink-dim">
            Tell us about your market, your channels and your volume. We come back with a range
            proposal, indicative pricing and the certificates your buyers will ask for.
          </p>
          <div class="xcta__actions">
            <a href="/distributors/" class="btn btn-primary">
              Open the distributor brief
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="/samples/" class="btn btn-secondary">Request a sample box</a>
          </div>
        </div>
      </div>

      <div class="xcta__flow" role="list">
        {flow.map((f, i) => (
          <div class="xcta__step" role="listitem" data-reveal>
            {i > 0 && <span class="xcta__arrow" aria-hidden="true">&rarr;</span>}
            <span class="xcta__phase">{f.phase}</span>
            <span class="op-label ink-dim xcta__note">{f.note}</span>
          </div>
        ))}
      </div>

      <p class="op-label ink-dim xcta__contact">
        Direct: <a href={`mailto:${site.email}`}>{site.email}</a> · {site.phone}
      </p>
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../lib/motion";
  revealOnScroll(document.querySelectorAll(".xcta [data-reveal]"), { y: 20, stagger: 0.09 });
</script>

<style>
  .xcta { --scene-pad: clamp(4rem, 9vw, 7rem); }
  .xcta__top { align-items: end; }

  .xcta__title {
    font-family: var(--font-display);
    color: var(--scene-title, var(--scene-ink));
    margin-block-start: 0.75rem;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    line-height: 1.0;
    letter-spacing: -0.01em;
    font-weight: 700;
    max-inline-size: 16ch;
  }
  .xcta__side { display: flex; flex-direction: column; gap: 1.5rem; }
  .xcta__sub { font-size: var(--text-body-lg); line-height: 1.6; max-inline-size: 46ch; }
  .xcta__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }

  .xcta__flow {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--scene-line);
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 760px) { .xcta__flow { grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); } }

  .xcta__step { position: relative; display: flex; flex-direction: column; gap: 0.4rem; }
  .xcta__arrow {
    position: absolute;
    inset-inline-start: calc(-1 * clamp(0.75rem, 2vw, 1.75rem));
    inset-block-start: 0;
    transform: translateX(-50%);
    color: var(--scene-accent);
    font-size: 1.1rem;
  }
  @media (max-width: 759px) { .xcta__arrow { display: none; } }
  .xcta__phase {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--scene-ink);
  }
  .xcta__note { max-inline-size: 30ch; }

  .xcta__contact { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .xcta__contact a { color: var(--scene-accent); text-decoration: none; }
  .xcta__contact a:hover { text-decoration: underline; }
</style>
