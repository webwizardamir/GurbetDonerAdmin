---
// Scene 03 — The Production Story. A pinned, documentary sequence: a sticky facility visual
// cross-dissolves through four beats while the narrative scrolls beside it. The active beat
// lights up and drives a label + progress on the image, so the column reads as a live walk-through
// rather than a static list. Facility stills are dunya placeholders (cleared for use) until brand
// footage exists. No step numbers.
interface Props { scene?: string }
const { scene = "black" } = Astro.props;
const beats = [
  {
    title: "Sourcing",
    img: "/images/facility/line-3.jpg",
    alt: "Production facility, the Netherlands",
    body: "Halal-certified raw material arrives under specification. Every intake is logged against the lot it will become.",
  },
  {
    title: "Production",
    img: "/images/facility/line-2.jpg",
    alt: "Production floor in operation",
    body: "Portioning, forming and coating run to fixed tolerances. The line is built for repeatability, shift after shift.",
  },
  {
    title: "Quality release",
    img: "/images/facility/exterior-1.jpg",
    alt: "Quality control area",
    body: "Weight, coating and core temperature are checked, not assumed. No pallet leaves the floor without a signed release.",
  },
  {
    title: "Logistics",
    img: "/images/facility/line-1.jpg",
    alt: "Cold-chain dispatch",
    body: "Frozen, palletised and loaded with the cold chain intact, then shipped to distributors across Europe.",
  },
];
---

<section class="scene story" data-scene={scene} id="story" aria-label="The production story">
  <div class={`grain${scene === "light" ? " grain--dark" : ""}`} aria-hidden="true"></div>
  <div class="container-x">
    <header class="story__head grid-ed grid-ed--7-5">
      <h2 class="story__title text-display">From intake to pallet, held to one standard.</h2>
      <p class="story__lede ink-dim">
        One specification, from raw intake to the loading bay. Four stages, the same discipline at each.
      </p>
    </header>

    <div class="story__cols grid-ed grid-ed--5-7">
      <div class="story__media" aria-hidden="true">
        <div class="story__frame">
          {beats.map((b, i) => (
            <img src={b.img} alt="" class={`story__img${i === 0 ? " is-active" : ""}`} loading="lazy" decoding="async" />
          ))}
          <span class="story__media-tag op-label">Amsterdam, NL</span>
          <div class="story__media-overlay">
            <span class="story__media-step" data-story-step>{beats[0].title}</span>
            <span class="story__progress" data-story-progress>
              {beats.map((_, i) => (
                <span class={`story__progress-seg${i === 0 ? " is-active" : ""}`}></span>
              ))}
            </span>
          </div>
        </div>
      </div>

      <ol class="story__beats">
        {beats.map((b) => (
          <li class="story__beat" data-story-beat>
            <img src={b.img} alt={b.alt} class="story__beat-img" loading="lazy" decoding="async" />
            <div class="story__beat-text" data-reveal>
              <h3 class="story__beat-title">{b.title}</h3>
              <p class="story__beat-body ink-dim">{b.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { initGsap, prefersReducedMotion, revealOnScroll } from "../../lib/motion";

  const story = document.querySelector<HTMLElement>(".story");
  if (story) {
    revealOnScroll(story.querySelectorAll("[data-reveal]"), { y: 24, stagger: 0.06 });

    const imgs = Array.from(story.querySelectorAll<HTMLElement>(".story__img"));
    const beats = Array.from(story.querySelectorAll<HTMLElement>("[data-story-beat]"));
    const segs = Array.from(story.querySelectorAll<HTMLElement>(".story__progress-seg"));
    const stepLabel = story.querySelector<HTMLElement>("[data-story-step]");
    const titles = beats.map((b) => b.querySelector(".story__beat-title")?.textContent ?? "");

    if (!prefersReducedMotion() && imgs.length && window.matchMedia("(min-width: 880px)").matches) {
      const { ScrollTrigger } = initGsap();
      const setActive = (i: number) => {
        imgs.forEach((im, k) => im.classList.toggle("is-active", k === i));
        beats.forEach((bt, k) => bt.classList.toggle("is-active", k === i));
        segs.forEach((s, k) => s.classList.toggle("is-active", k <= i));
        if (stepLabel) stepLabel.textContent = titles[i];
      };
      beats.forEach((beat, i) => {
        ScrollTrigger.create({
          trigger: beat,
          start: "top 60%",
          end: "bottom 60%",
          onToggle: (self) => self.isActive && setActive(i),
        });
      });
    }
  }
</script>

<style>
  .story { --scene-pad: clamp(2.75rem, 6vw, 4.5rem); overflow: clip; }

  .story__head { align-items: end; margin-block-end: clamp(2rem, 4vw, 3.25rem); }
  .story__title {
    color: var(--scene-title, var(--scene-ink));
    max-inline-size: 18ch;
  }
  .story__lede { font-size: var(--text-body-lg); line-height: 1.6; max-inline-size: 40ch; }

  .story__cols { align-items: start; }

  /* Sticky media column (desktop) */
  .story__media { display: none; }
  @media (min-width: 880px) {
    .story__media { display: block; position: sticky; inset-block-start: calc(var(--header-h) + 2.5rem); }
    .story__frame {
      position: relative;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--scene-line);
      box-shadow: 0 30px 60px -50px rgba(15, 81, 50, 0.4);
    }
  }
  .story__img {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.8s var(--ease-out-expo), transform 1.2s var(--ease-out-expo);
    /* Lighter duotone than the dark build so the footage reads crisp on the light scene. */
    filter: saturate(0.72) contrast(1.03) brightness(0.92);
  }
  .story__img.is-active { opacity: 1; transform: scale(1); }

  .story__media-tag {
    position: absolute;
    inset-block-start: 1rem;
    inset-inline-start: 1rem;
    z-index: 1;
    color: var(--color-paper);
    background: rgba(5, 26, 16, 0.55);
    backdrop-filter: blur(4px);
    padding: 0.3rem 0.6rem;
    border-radius: 99px;
  }
  .story__media-overlay {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 1;
    padding: clamp(1.1rem, 2vw, 1.6rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background: linear-gradient(0deg, rgba(5, 26, 16, 0.9), rgba(5, 26, 16, 0.3) 60%, transparent);
  }
  .story__media-step {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    line-height: 1.05;
    color: var(--color-bone);
  }
  .story__progress { display: flex; gap: 6px; }
  .story__progress-seg {
    block-size: 3px;
    flex: 1;
    border-radius: 99px;
    background: rgba(251, 248, 240, 0.22);
    transition: background 0.5s var(--ease-out-expo);
  }
  .story__progress-seg.is-active { background: var(--color-gold-soft); }

  /* Beats */
  .story__beats { list-style: none; margin: 0; padding: 0; }
  .story__beat { padding-block: clamp(1.5rem, 3vw, 2.25rem); }
  .story__beat:not(:last-child) { border-block-end: 1px solid var(--scene-line); }

  .story__beat-img {
    inline-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
    margin-block-end: 1.25rem;
    filter: saturate(0.72) contrast(1.03) brightness(0.92);
  }
  @media (min-width: 880px) { .story__beat-img { display: none; } }

  .story__beat-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--scene-title, var(--scene-ink));
    margin: 0 0 0.6rem;
  }
  .story__beat-body { font-size: var(--text-body-lg); line-height: 1.6; max-inline-size: 46ch; margin: 0; }

  /* Desktop: the active beat lights up; the rest sit back. A left accent rail tracks the walk. */
  @media (min-width: 880px) {
    .story__beat { min-block-size: 40vh; display: flex; align-items: center; }
    .story__beat-text {
      border-inline-start: 2px solid var(--scene-line);
      padding-inline-start: clamp(1.25rem, 2vw, 2rem);
      opacity: 0.4;
      transition: opacity 0.5s var(--ease-out-expo), border-color 0.5s var(--ease-out-expo);
    }
    .story__beat.is-active .story__beat-text { opacity: 1; border-inline-start-color: var(--scene-accent); }
  }
</style>
