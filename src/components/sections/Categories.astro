---
import { site } from "../../lib/site";
import { getCollection } from "astro:content";

// Pull a hero image per category from the content collection.
let allProducts: Array<{ slug: string; name: string; category: string; image?: string }> = [];
try {
  const collection = await getCollection("products");
  allProducts = collection.map((p) => ({
    slug: p.id,
    name: p.data.name,
    category: p.data.category,
    image: p.data.image,
  }));
} catch {}

const accent: Record<string, { hue: string; cover: string | undefined }> = {
  chicken: {
    hue: "rgba(201, 162, 75, 0.30)",
    cover: allProducts.find((p) => p.slug === "sliced-roasted-chicken-kebab")?.image,
  },
  beef: {
    hue: "rgba(163, 58, 42, 0.28)",
    cover: allProducts.find((p) => p.slug === "sliced-roasted-beef-kebab")?.image,
  },
  snacks: {
    hue: "rgba(31, 106, 71, 0.30)",
    cover: allProducts.find((p) => p.slug === "frikandel" || p.slug === "mozzarella-sticks")?.image,
  },
};
---

<section id="categories" class="cats section" aria-labelledby="cats-title">
  <div class="cats__bg" aria-hidden="true"></div>
  <div class="container-x">
    <div class="cats__head reveal">
      <div class="cats__head-text">
        <p class="eyebrow">Our range</p>
        <h2 id="cats-title" class="text-display cats__title">
          Three ranges. One uncompromising standard.
        </h2>
      </div>
      <div class="cats__head-aside">
        <p>
          Built for foodservice and retail buyers who can&rsquo;t afford inconsistency.
          Every product is portion-controlled, fully traceable and halal-certified.
        </p>
        <a href="/products/" class="btn btn-ghost cats__head-cta">View the full catalogue →</a>
      </div>
    </div>

    <ol class="cats__grid">
      {
        site.productCategories.map((c, i) => {
          const a = accent[c.slug];
          return (
            <li class="cats__card reveal" style={`--accent: ${a?.hue ?? "rgba(15,81,50,0.3)"}; --i:${i};`}>
              <a href={`/products/${c.slug}/`} class="cats__link">
                <div class="cats__bg-card" aria-hidden="true">
                  {a?.cover && (
                    <img src={a.cover} alt="" loading="lazy" />
                  )}
                </div>
                <div class="cats__top">
                  <span class="cats__num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="cats__name font-display">{c.name}</span>
                </div>
                <p class="cats__desc">{c.description}</p>
                <span class="cats__cta">
                  Explore {c.name.toLowerCase()}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<!-- Wave bridges bone (Categories) to cream (FeaturedProducts).
     Cream fills the BOTTOM of the SVG, wavy edge sits on TOP, so cream rises smoothly into bone. -->
<div class="cats__divider" aria-hidden="true">
  <svg viewBox="0 0 1440 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,40 C240,8 480,8 720,38 C960,68 1200,68 1440,30 L1440,90 L0,90 Z" fill="var(--color-cream)"/>
  </svg>
</div>

<style>
  .cats {
    position: relative;
    background: var(--color-bone);
    isolation: isolate;
  }
  .cats__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(900px 600px at 100% -10%, rgba(201, 162, 75, 0.12), transparent 60%);
  }
  .cats__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-block-end: clamp(2rem, 4vw, 3rem);
    align-items: end;
  }
  @media (min-width: 880px) {
    .cats__head {
      grid-template-columns: 6fr 5fr;
      gap: clamp(2rem, 4vw, 4rem);
    }
  }
  .cats__title { margin: 0.75rem 0 0; color: var(--color-charcoal); max-inline-size: 18ch; }
  .cats__head-aside { color: var(--color-slate-700); }
  .cats__head-aside p { margin: 0; line-height: 1.55; max-inline-size: 42ch; font-size: 1.0625rem; }
  .cats__head-cta { margin-block-start: 1rem; font-size: 0.9375rem; }

  .cats__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) { .cats__grid { grid-template-columns: repeat(3, 1fr); } }

  .cats__card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    isolation: isolate;
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    transition:
      transform 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo),
      border-color 0.4s var(--ease-out-expo);
    transition-delay: calc(var(--i, 0) * 70ms);
    min-block-size: 22rem;
  }
  .cats__card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-emerald) 30%, var(--color-line));
    box-shadow: 0 1px 0 rgba(22,19,17,0.04), 0 22px 36px -24px rgba(22,19,17,0.28);
  }
  .cats__bg-card {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(720px 420px at 100% 0%, var(--accent), transparent 60%),
      linear-gradient(180deg, var(--color-cream), color-mix(in srgb, var(--color-cream) 80%, white));
  }
  .cats__bg-card img {
    position: absolute;
    inset-block-start: 30%;
    inset-inline-end: -10%;
    inline-size: 75%;
    block-size: auto;
    opacity: 0.85;
    transform: rotate(-6deg);
    transition: transform 0.6s var(--ease-out-expo), opacity 0.4s var(--ease-out-expo);
    filter: drop-shadow(0 10px 30px rgba(22,19,17,0.18));
  }
  .cats__card:hover .cats__bg-card img {
    transform: rotate(-3deg) translateY(-4px) scale(1.03);
    opacity: 1;
  }

  .cats__link {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 3vw, 1.875rem);
    height: 100%;
    color: var(--color-charcoal);
    text-decoration: none;
  }
  .cats__top {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.875rem;
    padding-block-end: 0.875rem;
    margin-block-end: 0.25rem;
  }
  .cats__num {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    font-weight: 600;
  }
  .cats__name {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 500;
    font-variation-settings: "opsz" 96, "SOFT" 50;
  }
  .cats__desc {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-slate-700);
    max-inline-size: 30ch;
    margin: 0;
  }
  .cats__cta {
    margin-block-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-emerald);
    letter-spacing: -0.005em;
    transition: gap 0.25s var(--ease-out-expo);
    padding-block-start: 0.5rem;
  }
  .cats__card:hover .cats__cta { gap: 0.875rem; }

  .cats__divider {
    background: var(--color-bone); /* matches Categories above so the empty top of the SVG has no seam */
    line-height: 0;
  }
  .cats__divider svg {
    display: block;
    inline-size: 100%;
    block-size: clamp(40px, 5vw, 80px);
    margin-block-start: -1px;
  }
</style>
