---
// Scene — Certifications, minimalist. Homepage replacement for the bone certs card grid
// (the shared Certifications.astro stays for About / products pages). An editorial head
// (verification statement + aside) over a single row of certification marks, on the plain
// light body (no box) so the boxed CTA above and the tinted footer below stay distinct.
// Verifiable only: authority named on request; HACCP + ISO 22000 stay text seals (no badge image).
const certs = [
  { code: "Halal", image: "/images/certifications/halal.png", note: "Accredited authority" },
  { code: "BRC", image: "/images/certifications/brc.png", note: "BRCGS Food Safety" },
  { code: "IFS", image: "/images/certifications/ifs.png", note: "IFS Food" },
  { code: "HACCP", note: "Food-safety baseline" },
  { code: "ISO 22000", note: "Management system" },
];
---

<section id="certifications" class="scene certs2" data-scene="light" aria-labelledby="certs2-title">
  <div class="grain grain--dark" aria-hidden="true"></div>
  <div class="container-x">
    <div class="certs2__head grid-ed grid-ed--7-5">
      <div>
        <h2 id="certs2-title" class="certs2__title text-display">Certifications.</h2>
      </div>
      <p class="certs2__aside ink-dim">
        Certificates are available on request.
      </p>
    </div>

    <ul class="certrow" data-reveal>
      {certs.map((c) => (
        <li class="certrow__item">
          <span class="certrow__mark">
            {c.image
              ? <img src={c.image} alt={`${c.code} certification`} loading="lazy" decoding="async" />
              : <span class="certrow__seal font-x">{c.code}</span>}
          </span>
          <span class="op-label certrow__note">{c.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../lib/motion";
  revealOnScroll(document.querySelectorAll(".certs2 [data-reveal]"), { y: 20 });
</script>

<style>
  .certs2 { --scene-pad: clamp(2.25rem, 4.5vw, 3.5rem); }
  .certs2__head { align-items: end; margin-block-end: clamp(2.5rem, 5vw, 4rem); }
  .certs2__title { color: var(--scene-title, var(--scene-ink)); max-inline-size: 16ch; margin-block-start: 0.5rem; }
  .certs2__aside { font-size: 1rem; line-height: 1.6; max-inline-size: 46ch; }

  /* A single row of certification marks, hairline-separated, sitting on the plain light body. */
  .certrow {
    list-style: none;
    margin: 0;
    padding-block-start: clamp(1.75rem, 4vw, 2.75rem);
    border-block-start: 1px solid var(--scene-line);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .certrow__item {
    position: relative;
    flex: 1 1 0;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }
  /* Thin vertical separator centred in the gap before each mark after the first. */
  .certrow__item + .certrow__item::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(clamp(1.5rem, 4vw, 3.5rem) * -0.5);
    inset-block: 0.25rem auto;
    block-size: clamp(52px, 7vw, 76px);
    inline-size: 1px;
    background: var(--scene-line);
  }

  .certrow__mark {
    block-size: clamp(52px, 7vw, 76px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .certrow__mark img { block-size: 100%; inline-size: auto; object-fit: contain; }
  .certrow__seal {
    font-size: clamp(1.5rem, 3vw, 2.05rem);
    font-weight: 800;
    color: var(--color-emerald);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }
  .certrow__note { color: var(--scene-ink-dim); }

  /* Below the row's one-line ideal: wrap to a tidy two-per-row, drop the separators. */
  @media (max-width: 639px) {
    .certrow { gap: 2rem 1.25rem; }
    .certrow__item { flex-basis: 38%; }
    .certrow__item + .certrow__item::before { display: none; }
  }
</style>
