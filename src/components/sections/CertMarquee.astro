---
// Green moving marquee under the hero (reference-site style): each certification as a white
// icon chip + label, scrolling in a seamless loop. Replaces the separate cert section.
// Halal/BRC/IFS use the real badge logos; HACCP/ISO 22000 (text seals, no logo) get a check icon.
const certs = [
  { label: "Halal", img: "/images/certifications/halal.png" },
  { label: "BRC", img: "/images/certifications/brc.png" },
  { label: "IFS", img: "/images/certifications/ifs.png" },
  { label: "HACCP" },
  { label: "ISO 22000" },
];
const group = [...certs, ...certs, ...certs];
---

<section class="cmarquee" aria-label="Certifications">
  <div class="cmarquee__track" aria-hidden="true">
    <ul class="cmarquee__group">
      {group.map((c) => (
        <li class="cmarquee__item">
          <span class="cmarquee__chip">
            {c.img
              ? <img src={c.img} alt="" loading="lazy" decoding="async" />
              : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>}
          </span>
          <span class="cmarquee__label">{c.label}</span>
        </li>
      ))}
    </ul>
    <ul class="cmarquee__group">
      {group.map((c) => (
        <li class="cmarquee__item">
          <span class="cmarquee__chip">
            {c.img
              ? <img src={c.img} alt="" loading="lazy" decoding="async" />
              : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>}
          </span>
          <span class="cmarquee__label">{c.label}</span>
        </li>
      ))}
    </ul>
  </div>
  <span class="sr-only">Certified: Halal, BRC, IFS, HACCP, ISO 22000.</span>
</section>

<style>
  .cmarquee {
    background: var(--color-emerald); /* medium green band, between the dark hero and cream body */
    overflow: hidden;
    padding-block: clamp(0.7rem, 1.4vw, 1rem);
  }
  .cmarquee__track {
    display: flex;
    inline-size: max-content;
    animation: cmarquee-scroll 42s linear infinite;
  }
  .cmarquee__group { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .cmarquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding-inline-end: clamp(1.5rem, 4vw, 3rem);
    white-space: nowrap;
  }
  .cmarquee__chip {
    inline-size: clamp(26px, 3.2vw, 33px);
    block-size: clamp(26px, 3.2vw, 33px);
    flex: 0 0 auto;
    border-radius: 999px;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px -3px rgba(0, 48, 12, 0.45);
  }
  .cmarquee__chip img { inline-size: 76%; block-size: 76%; object-fit: contain; }
  .cmarquee__chip svg { inline-size: 52%; block-size: 52%; color: var(--color-emerald); }
  .cmarquee__label {
    font-family: var(--font-display);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: clamp(0.78rem, 1.2vw, 1rem);
    color: var(--color-snow);
  }
  @keyframes cmarquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cmarquee__track { animation: none; inline-size: 100%; }
    .cmarquee__group:last-child { display: none; }
    .cmarquee__group { flex-wrap: wrap; justify-content: center; gap: 0.5rem 0; }
  }
</style>
