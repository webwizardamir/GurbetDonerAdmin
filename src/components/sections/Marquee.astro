---
const items = [
  "Halal certified",
  "Made in the Netherlands",
  "Shipped EU-wide",
  "HACCP",
  "BRC Food",
  "IFS Food",
  "ISO 22000",
  "Cold chain",
  "Pallet ready",
  "Audited continuously",
  "From farm to fork",
];
// Duplicate for seamless loop.
const loop = [...items, ...items];
---

<section class="mq" aria-label="What we stand for">
  <div class="mq__track" aria-hidden="true">
    {loop.map((t, i) => (
      <span class="mq__item" data-i={i}>
        <svg class="mq__sep" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2 L13.6 8.6 L20.5 8.8 L15 12.8 L17 19 L12 15.3 L7 19 L9 12.8 L3.5 8.8 L10.4 8.6 Z" fill="currentColor"/>
        </svg>
        <span class="mq__label font-display">{t}</span>
      </span>
    ))}
  </div>
</section>

<style>
  .mq {
    position: relative;
    background: var(--color-bone);
    border-block: 1px solid var(--color-line);
    overflow: hidden;
    padding-block: clamp(14px, 1.8vw, 22px);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .mq__track {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    white-space: nowrap;
    animation: mq-scroll 42s linear infinite;
    will-change: transform;
  }
  .mq:hover .mq__track { animation-play-state: paused; }
  .mq__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-charcoal);
  }
  .mq__sep { color: var(--color-gold); flex-shrink: 0; }
  .mq__label {
    font-size: clamp(1.1rem, 1.8vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variation-settings: "opsz" 36;
  }
  @keyframes mq-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mq__track { animation: none; }
  }
</style>
