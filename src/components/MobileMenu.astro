---
import { site } from "../lib/site";
---

<div id="mobile-nav" class="mobile-menu" data-mobile-panel data-state="closed" aria-hidden="true">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__head">
      <a href="/" class="mobile-menu__brand" data-mm-close>
        <img src="/logo.png" alt={site.fullName} width="259" height="120" />
      </a>
      <button class="mobile-menu__close" type="button" aria-label="Close menu" data-mm-close>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <p class="eyebrow eyebrow--bone mobile-menu__eyebrow">Menu</p>
    <nav aria-label="Mobile primary">
      <ul class="mobile-menu__list">
        <li><a href="/" data-mm-close><span class="mobile-menu__num">01</span><span class="mobile-menu__label font-display">Home</span></a></li>
        {site.nav.map((item, i) => (
          <li>
            <a href={item.href} data-mm-close>
              <span class="mobile-menu__num">{String(i + 2).padStart(2, "0")}</span>
              <span class="mobile-menu__label font-display">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__cta">
      <a href="/distributors/" class="btn btn-primary mobile-menu__btn-primary" data-mm-close>Become a distributor</a>
      <a href="/samples/" class="btn btn-secondary-light mobile-menu__btn-secondary" data-mm-close>Request samples</a>
    </div>

    <div class="mobile-menu__contact">
      <p class="eyebrow eyebrow--bone">Get in touch</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a>
    </div>

    <div class="mobile-menu__social">
      <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram">Instagram</a>
      <span aria-hidden="true">·</span>
      <a href={site.social.linkedin} rel="noopener" target="_blank" aria-label="LinkedIn">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 70;
    color: var(--color-bone);
    background: var(--color-emerald-deep);
    background-image:
      radial-gradient(900px 600px at 100% 0%, rgba(201, 162, 75, 0.18), transparent 60%),
      radial-gradient(700px 500px at 0% 100%, rgba(31, 106, 71, 0.5), transparent 55%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out-expo);
    overflow-y: auto;
  }
  .mobile-menu[data-state="open"] {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu__inner {
    min-height: 100%;
    padding: 1.25rem var(--gutter) 2.5rem;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .mobile-menu__brand img { height: 38px; width: auto; }
  .mobile-menu__close {
    background: transparent;
    border: 0;
    color: var(--color-bone);
    padding: 8px;
    margin-inline-end: -8px;
    cursor: pointer;
    border-radius: var(--radius);
    transition: background 0.2s var(--ease-out-expo);
  }
  .mobile-menu__close:hover { background: rgba(251, 248, 240, 0.08); }

  .mobile-menu__eyebrow { margin-block-start: 1.5rem; }

  .mobile-menu__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(251, 248, 240, 0.12);
    color: var(--color-bone);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo), padding-inline-start 0.25s var(--ease-out-expo);
  }
  .mobile-menu__list a:hover { color: var(--color-gold-soft); padding-inline-start: 6px; }
  .mobile-menu__num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--color-gold-soft);
    letter-spacing: 0.06em;
    flex-shrink: 0;
    inline-size: 28px;
  }
  .mobile-menu__label {
    font-size: clamp(1.5rem, 5.5vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    font-weight: 500;
  }

  .mobile-menu__cta {
    margin-block-start: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .mobile-menu__btn-primary,
  .mobile-menu__btn-secondary {
    justify-content: center;
    padding-block: 1rem;
    font-size: 0.9375rem;
  }

  .mobile-menu__contact {
    margin-block-start: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-menu__contact a {
    color: rgba(251, 248, 240, 0.85);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-block-start: 0.5rem;
    transition: color 0.2s var(--ease-out-expo);
  }
  .mobile-menu__contact a:hover { color: var(--color-gold-soft); }

  .mobile-menu__social {
    margin-block-start: auto;
    padding-block-start: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: rgba(251, 248, 240, 0.6);
  }
  .mobile-menu__social a {
    color: rgba(251, 248, 240, 0.85);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .mobile-menu__social a:hover { border-block-end-color: currentColor; }

  body.is-menu-open { overflow: hidden; }
</style>
