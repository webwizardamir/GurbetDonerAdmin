---
import { site } from "../lib/site";
const year = new Date().getFullYear();
---

<!-- Wave bridges the section above into the footer. On the dark homepage both sides are dark
     so it reads as a clean cut; on the bone About/products pages it curves bone into the footer. -->
<div class="footer-divider-top" aria-hidden="true">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M0,80 L0,30 C240,72 480,72 720,42 C960,12 1200,12 1440,50 L1440,80 Z" fill="var(--color-emerald-black)"/>
  </svg>
</div>

<footer class="site-footer">
  <div class="container-x section-sm">
    <div class="footer__masthead">
      <p class="footer__statement">Halal frozen food, made in the Netherlands. Shipped across Europe.</p>
      <ul class="footer__ops" aria-label="At a glance">
        <li class="op-label">Made in the Netherlands</li>
        <li class="op-label">Shipped EU-wide</li>
        <li class="op-label">Halal · BRC · IFS</li>
      </ul>
    </div>

    <div class="footer__grid">
      <div class="footer__brand">
        <img src="/logo.png" alt={site.fullName} width="324" height="150" class="footer__logo" />
        <p class="footer__intro">
          Halal, perfected. Built in the Netherlands. Premium halal frozen ranges for distributors,
          retailers and HoReCa partners across Europe.
        </p>
        <div class="footer__cta">
          <a href="/distributors/" class="btn btn-primary footer__btn">Become a distributor</a>
          <a href="/samples/" class="btn btn-secondary-light footer__btn">Request samples</a>
        </div>
      </div>

      <div class="footer__col">
        <p class="footer__heading">Range</p>
        <ul class="footer__list">
          {site.productCategories.map((c) => (
            <li><a href={`/products/${c.slug}/`}>{c.name}</a></li>
          ))}
          <li><a href="/products/">All products</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <p class="footer__heading">Company</p>
        <ul class="footer__list">
          <li><a href="/about/">About</a></li>
          <li><a href="/about/#halal">Halal promise</a></li>
          <li><a href="/about/#certifications">Certifications</a></li>
          <li><a href="/distributors/">Distributors</a></li>
        </ul>
      </div>

      <div class="footer__col footer__contact">
        <p class="footer__heading">Contact</p>
        <address class="footer__addr">
          {site.address.line1}<br />
          {site.address.postal} {site.address.city}<br />
          {site.address.country}
        </address>
        <div class="footer__lines">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a>
        </div>
        <div class="footer__social">
          <a href={site.social.linkedin} aria-label="LinkedIn" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="3" /><path d="M6.5 9.5v8.5M6.5 6.5v.01M10 18v-5.5a2.5 2.5 0 0 1 5 0V18M10 12v6"/></svg>
          </a>
          <a href={site.social.instagram} aria-label="Instagram" rel="noopener" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="footer__bar">
      <p>© {year} {site.fullName}. All rights reserved. Made in the Netherlands.</p>
      <ul class="footer__legal">
        <li><a href="/legal/privacy/">Privacy</a></li>
        <li><a href="/legal/cookies/">Cookies</a></li>
        <li><a href="/legal/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-divider-top {
    background: var(--color-bone); /* bone section above on About / products */
    line-height: 0;
  }
  /* New-system pages (dark homepage + light inner pages): the bone wave curve does not belong, so
     drop it and tighten the footer's top so it reads as one continuous block. It survives only on
     the not-yet-migrated legacy bone pages. */
  body:is(.has-dark-hero, .page-light) .footer-divider-top { display: none; }
  body:is(.has-dark-hero, .page-light) .site-footer .section-sm { padding-block-start: clamp(2.25rem, 4vw, 3.25rem); }
  .footer-divider-top svg {
    display: block;
    inline-size: 100%;
    block-size: clamp(40px, 5vw, 80px);
    margin-block-end: -1px;
  }
  .site-footer {
    background: var(--color-emerald-black);
    color: var(--color-bone);
  }
  .footer__masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block-end: clamp(2rem, 4vw, 3rem);
    margin-block-end: clamp(2rem, 4vw, 3rem);
    border-block-end: 1px solid rgba(251, 248, 240, 0.14);
  }
  .footer__statement {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.2vw, 2.6rem);
    line-height: 1.1;
    color: var(--color-bone);
    max-inline-size: 20ch;
  }
  .footer__ops {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    align-items: center;
  }
  .footer__ops li { color: var(--color-gold-soft); position: relative; padding-inline-start: 1.25rem; }
  .footer__ops li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 50%;
    inline-size: 5px; block-size: 5px;
    transform: translateY(-50%);
    border-radius: 99px;
    background: var(--color-brass);
  }

  .footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer__grid { grid-template-columns: 5fr 2fr 2fr 3fr; gap: 3rem; } }

  .footer__brand { display: flex; flex-direction: column; gap: 1.25rem; }
  .footer__logo {
    height: 90px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    align-self: flex-start;
    display: block;
    opacity: 0.95;
  }
  .footer__intro { color: rgba(251, 248, 240, 0.78); font-size: 1rem; line-height: 1.6; max-inline-size: 38ch; margin: 0; }
  .footer__cta { display: flex; flex-wrap: wrap; gap: 0.625rem; }
  .footer__btn { padding: 0.65rem 1rem; font-size: 0.875rem; }

  .footer__heading {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-gold-soft);
    font-weight: 600;
    margin: 0;
  }
  .footer__list { list-style: none; padding: 0; margin: 1rem 0 0; display: flex; flex-direction: column; gap: 0.625rem; }
  .footer__list a {
    color: rgba(251, 248, 240, 0.78);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s var(--ease-out-expo);
  }
  .footer__list a:hover { color: var(--color-bone); }

  .footer__addr { font-style: normal; margin: 1rem 0 0; color: rgba(251, 248, 240, 0.78); font-size: 0.9375rem; line-height: 1.6; }
  .footer__lines { display: flex; flex-direction: column; gap: 0.25rem; margin-block-start: 0.875rem; }
  .footer__lines a { color: rgba(251, 248, 240, 0.78); text-decoration: none; font-size: 0.9375rem; transition: color 0.2s var(--ease-out-expo); }
  .footer__lines a:hover { color: var(--color-gold-soft); }

  .footer__social { display: flex; align-items: center; gap: 0.625rem; margin-block-start: 1rem; }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    border-radius: 9999px;
    border: 1px solid rgba(251, 248, 240, 0.18);
    color: rgba(251, 248, 240, 0.78);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo), background 0.2s var(--ease-out-expo);
  }
  .footer__social a:hover {
    color: var(--color-emerald-deep);
    background: var(--color-gold-soft);
    border-color: var(--color-gold-soft);
  }

  .footer__bar {
    margin-block-start: 2.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid rgba(251, 248, 240, 0.12);
    display: flex;
    flex-direction: column-reverse;
    gap: 0.875rem;
    font-size: 0.75rem;
    color: rgba(251, 248, 240, 0.55);
  }
  @media (min-width: 720px) { .footer__bar { flex-direction: row; align-items: center; justify-content: space-between; } }
  .footer__bar p { margin: 0; }
  .footer__legal { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer__legal a {
    color: rgba(251, 248, 240, 0.55);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo);
  }
  .footer__legal a:hover { color: var(--color-bone); }

  /* ----------------------------------------------------------------
     Light-dominant footer for the new-system pages (homepage `has-dark-hero` + light inner pages
     `page-light`). Reads as the page's grounded base: the same soft emerald tint as the inset
     panels above, with dark ink. Legacy bone pages keep the default dark footer above until they
     are migrated. logo.png is full-colour on transparency, so it stays legible on light, no swap.
  ----------------------------------------------------------------- */
  body:is(.has-dark-hero, .page-light) .site-footer {
    background: var(--color-panel);
    color: var(--color-slate-700);
    border-block-start: 1px solid rgba(15, 81, 50, 0.12);
  }
  body:is(.has-dark-hero, .page-light) .footer__statement { color: var(--color-emerald); }
  body:is(.has-dark-hero, .page-light) .footer__masthead { border-block-end-color: rgba(15, 81, 50, 0.16); }
  body:is(.has-dark-hero, .page-light) .footer__ops li { color: var(--color-slate-700); }
  body:is(.has-dark-hero, .page-light) .footer__intro { color: var(--color-slate-700); }
  body:is(.has-dark-hero, .page-light) .footer__heading { color: var(--color-brass-deep); }
  body:is(.has-dark-hero, .page-light) .footer__list a,
  body:is(.has-dark-hero, .page-light) .footer__lines a,
  body:is(.has-dark-hero, .page-light) .footer__addr { color: var(--color-slate-700); }
  body:is(.has-dark-hero, .page-light) .footer__list a:hover,
  body:is(.has-dark-hero, .page-light) .footer__lines a:hover { color: var(--color-emerald); }
  body:is(.has-dark-hero, .page-light) .footer__social a {
    border-color: rgba(15, 81, 50, 0.22);
    color: var(--color-slate-700);
  }
  body:is(.has-dark-hero, .page-light) .footer__social a:hover {
    background: var(--color-emerald);
    color: var(--color-bone);
    border-color: var(--color-emerald);
  }
  body:is(.has-dark-hero, .page-light) .footer__bar {
    border-block-start-color: rgba(15, 81, 50, 0.14);
    color: var(--color-slate-500);
  }
  body:is(.has-dark-hero, .page-light) .footer__legal a { color: var(--color-slate-500); }
  body:is(.has-dark-hero, .page-light) .footer__legal a:hover { color: var(--color-emerald); }
  /* Shared markup uses btn-secondary-light (for dark pages); restyle it to a dark outline here. */
  body:is(.has-dark-hero, .page-light) .site-footer .btn-secondary-light {
    color: var(--color-charcoal);
    border-color: rgba(22, 19, 17, 0.45);
  }
  body:is(.has-dark-hero, .page-light) .site-footer .btn-secondary-light:hover {
    background: var(--color-charcoal);
    color: var(--color-bone);
    border-color: var(--color-charcoal);
  }
</style>
