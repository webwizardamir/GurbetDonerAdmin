---
import Base from "../../layouts/Base.astro";
---

<Base title="Privacy policy" description="How Melek collects and handles your data.">
  <article class="legal">
    <div class="container-narrow section">
      <p class="eyebrow">Legal</p>
      <h1 class="text-display font-display legal__title">Privacy policy.</h1>
      <p class="text-body-lg legal__lede">
        We collect only what we need to respond to your enquiry, and we don't sell your data to anyone.
      </p>
      <p>
        Forms on this site (contact, distributor application, sample request) capture the fields you
        complete and are routed to our sales team. We retain enquiries for as long as needed to handle them
        and reasonable follow-up. You can ask us to delete your data at any time by writing to our general inbox.
      </p>
      <p>
        We use functional cookies only — no behavioural tracking. Vercel handles hosting and may log
        request metadata required for security and performance.
      </p>
      <p class="legal__draft">
        This page is a placeholder draft. Final wording will be reviewed by counsel before launch.
      </p>
    </div>
  </article>
</Base>

<style>
  .legal { background: var(--color-bone); }
  .legal__title { margin: 1rem 0 0; color: var(--color-charcoal); }
  .legal__lede { margin-block-start: 1.25rem; color: var(--color-slate-700); max-inline-size: 60ch; }
  .legal p { margin: 1.25rem 0 0; color: var(--color-slate-700); line-height: 1.7; max-inline-size: 64ch; }
  .legal__draft { font-style: italic; color: var(--color-slate-500); }
</style>
