---
import Base from "../../layouts/Base.astro";
---

<Base title="Cookies" description="Cookies used by Melek's website.">
  <article class="legal">
    <div class="container-narrow section">
      <h1 class="text-display font-display legal__title">Cookies.</h1>
      <p class="text-body-lg legal__lede">
        We use the minimum number of cookies a modern site needs to function.
      </p>
      <p>
        This site uses functional cookies only — no advertising or third-party tracking.
        Our hosting provider (Vercel) may set request-level cookies required for security and routing.
      </p>
      <p class="legal__draft">
        Placeholder draft pending legal review.
      </p>
    </div>
  </article>
</Base>

<style>
  .legal { background: var(--color-bone); }
  .legal__title { margin: 1rem 0 0; color: var(--color-charcoal); }
  .legal__lede { margin-block-start: 1.25rem; color: var(--color-slate-700); max-inline-size: 60ch; }
  .legal p { margin: 1.25rem 0 0; color: var(--color-slate-700); line-height: 1.7; max-inline-size: 64ch; }
  .legal__draft { font-style: italic; color: var(--color-slate-500); }
</style>
