---
// Inline line-icon set for the six food categories. Decorative reinforcement of
// the always-present text label (so the glyphs can stay simple/abstract).
// Inherits colour via currentColor; size is controlled by the caller's CSS.
interface Props { slug: string; class?: string }
const { slug, class: className } = Astro.props;

// aria-hidden is set on the wrapping span by the caller (CategoryRail), so it is
// intentionally omitted here — spreading it widens the type and trips ts(2322).
const common = {
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.6",
  "stroke-linecap": "round" as const,
  "stroke-linejoin": "round" as const,
};
---

{slug === "meat" && (
  <svg {...common} class={className}>
    <path d="M4.5 10a5.5 5.5 0 0 1 5.5-5.5h3.5a6.5 6.5 0 0 1 0 13H10A5.5 5.5 0 0 1 4.5 10z" />
    <circle cx="9" cy="11" r="1.6" />
  </svg>
)}

{slug === "chicken" && (
  /* Drumstick (Lucide "drumstick", MIT). */
  <svg {...common} class={className}>
    <path d="M15.45 15.4c-2.13.65-4.3.32-5.7-1.1-2.29-2.27-1.76-6.5 1.17-9.42 2.93-2.93 7.15-3.46 9.43-1.18 1.41 1.41 1.74 3.57 1.1 5.71-1.4-.51-3.26-.02-4.64 1.36-1.38 1.38-1.87 3.23-1.36 4.63z" />
    <path d="m11.25 15.6-2.16 2.16a2.5 2.5 0 1 1-4.56 1.73 2.49 2.49 0 0 1-1.41-4.24 2.5 2.5 0 0 1 3.14-.32l2.16-2.16" />
  </svg>
)}

{slug === "potato" && (
  <svg {...common} class={className}>
    <path d="M6 9h12l-1 9.5a2 2 0 0 1-2 1.8H9a2 2 0 0 1-2-1.8z" />
    <path d="M9.5 9V5M12 9V4M14.5 9V5" />
  </svg>
)}

{slug === "snacks" && (
  <svg {...common} class={className}>
    <path d="M12 4.3c1.7 0 2.7 1.2 4 1.8s3 .5 3 2.6-1.3 2.6-1.3 4.3 .9 3-1.7 3.9-2.6-.9-4.3-.9-2.9 1.5-5 .7S4.6 17.6 4.6 15.9 6 13.7 5.5 12 4.6 8.6 6.7 7.7s3.6-3.4 5.3-3.4z" />
  </svg>
)}

{slug === "rice" && (
  <svg {...common} class={className}>
    <path d="M3.6 11h16.8a8.4 8.4 0 0 1-16.8 0z" />
    <path d="M9 7c-.6-.8-.6-1.7 0-2.5M12 7c-.6-.8-.6-1.7 0-2.5M15 7c-.6-.8-.6-1.7 0-2.5" />
  </svg>
)}

{slug === "olives" && (
  <svg {...common} class={className}>
    <ellipse cx="10.5" cy="14" rx="4.3" ry="5.3" />
    <path d="M14 8.5c1.4-2.6 3.9-3.8 6-3.8-.1 2.3-1.2 4.4-3.2 5.3" />
  </svg>
)}
