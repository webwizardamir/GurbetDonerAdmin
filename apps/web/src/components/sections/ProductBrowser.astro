---
// Reusable product browser: category tabs + live search + Packaging/Box toggle,
// over one flat grid of every product (rendered server-side as real links, then
// filtered client-side by toggling `hidden`). Used on the homepage and the
// products page. Reads the collection itself so no product array is serialized.
import { site } from "../../lib/site";
import { getAllProducts } from "../../lib/products";

interface Props {
  id?: string;
  scene?: string;
  heading?: string;
  showAllLink?: boolean;
}
const { id = "product-browser", scene = "light", heading, showAllLink = false } = Astro.props;

const products = await getAllProducts();
const cats = site.productCategories;
const formats = site.productFormats;
const catName = (slug: string) => cats.find((c) => c.slug === slug)?.name ?? "";
---

<section id={id} class="scene pb" data-scene={scene} aria-label="Browse products">
  <div class="grain grain--dark" aria-hidden="true"></div>
  <div class="container-x">
    {heading && <h2 class="pb__title text-display">{heading}</h2>}

    <div class="pb__controls">
      <div class="pb__tabs" role="tablist" aria-label="Product categories">
        <button type="button" class="cat-filter is-active" data-cat="all">All</button>
        {cats.map((c) => (
          <button type="button" class="cat-filter" data-cat={c.slug}>{c.name}</button>
        ))}
      </div>

      <div class="pb__tools">
        <div class="pb__search">
          <svg class="pb__search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.2-3.2"/></svg>
          <input
            type="search"
            class="input pb__input"
            placeholder="Search products"
            aria-label="Search products"
            autocomplete="off"
            data-pb-search
          />
        </div>
        <div class="seg" role="group" aria-label="Packaging or box">
          <button type="button" class="seg__btn is-active" data-fmt="all">All</button>
          {formats.map((f) => (
            <button type="button" class="seg__btn" data-fmt={f.slug}>{f.name}</button>
          ))}
        </div>
      </div>
    </div>

    <ul class="cat-grid pb__grid">
      {products.map((p) => (
        <li
          class="cat-card"
          data-cat={p.category}
          data-fmt={p.format}
          data-name={p.name.toLowerCase()}
        >
          <a class="cat-card__link" href={`/products/${p.id}/`}>
            <div class="cat-card__media">
              <img src={p.image} alt={p.name} loading="lazy" decoding="async" />
            </div>
            <div class="cat-card__meta">
              <span class="op-label ink-dim">{p.weight ?? catName(p.category)}</span>
              <span class="cat-card__name" title={p.name}>{p.name}</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <p class="pb__empty ink-dim" data-pb-empty hidden>
      No products match. Try another category or clear the search.
    </p>

    {showAllLink && (
      <div class="pb__foot">
        <a href="/products/" class="btn btn-secondary">View the full catalogue</a>
      </div>
    )}
  </div>
</section>

<script>
  const sections = document.querySelectorAll<HTMLElement>(".pb");
  sections.forEach((section) => {
    const cards = Array.from(section.querySelectorAll<HTMLElement>(".cat-card"));
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>(".cat-filter"));
    const segs = Array.from(section.querySelectorAll<HTMLButtonElement>(".seg__btn"));
    const segWrap = section.querySelector<HTMLElement>(".seg");
    const search = section.querySelector<HTMLInputElement>("[data-pb-search]");
    const empty = section.querySelector<HTMLElement>("[data-pb-empty]");

    const state = { category: "all", format: "all", query: "" };
    const validCats = new Set(tabs.map((t) => t.dataset.cat));

    // Which formats (packaging/box) each category actually contains. The
    // Packaging/Box toggle is only meaningful when a category has BOTH, so it is
    // disabled for single-format categories (e.g. rice, olives, potato, snacks).
    const formatsByCat: Record<string, Set<string>> = {};
    const allFormats = new Set<string>();
    for (const c of cards) {
      const cat = c.dataset.cat ?? "";
      const fmt = c.dataset.fmt ?? "";
      (formatsByCat[cat] ??= new Set()).add(fmt);
      allFormats.add(fmt);
    }

    const updateFormatToggle = () => {
      const avail = state.category === "all" ? allFormats : (formatsByCat[state.category] ?? new Set());
      const hasSplit = avail.size >= 2;
      if (!hasSplit) state.format = "all";
      segWrap?.classList.toggle("is-disabled", !hasSplit);
      for (const b of segs) b.disabled = !hasSplit;
    };

    const syncActive = (btns: HTMLButtonElement[], key: "cat" | "fmt", val: string) => {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset[key] === val));
    };

    const apply = () => {
      updateFormatToggle();
      let shown = 0;
      for (const c of cards) {
        const okCat = state.category === "all" || c.dataset.cat === state.category;
        const okFmt = state.format === "all" || c.dataset.fmt === state.format;
        const okQ = !state.query || (c.dataset.name ?? "").includes(state.query);
        const visible = okCat && okFmt && okQ;
        c.hidden = !visible;
        if (visible) shown++;
      }
      if (empty) empty.hidden = shown > 0;
      syncActive(tabs, "cat", state.category);
      syncActive(segs, "fmt", state.format);
    };

    const scrollToSelf = () => {
      // Let Lenis (if active) own smooth scrolling for hash anchors; here we only
      // need to bring the section into view on load / cross-page navigation.
      section.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        state.category = tab.dataset.cat!;
        history.replaceState(null, "", `#cat-${state.category}`);
        apply();
      });
    });

    segs.forEach((seg) => {
      seg.addEventListener("click", () => {
        state.format = seg.dataset.fmt!;
        apply();
      });
    });

    let t: number | undefined;
    search?.addEventListener("input", () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => {
        state.query = (search.value || "").trim().toLowerCase();
        apply();
      }, 120);
    });

    const selectFromHash = (scroll: boolean) => {
      const m = location.hash.match(/^#cat-([a-z-]+)/);
      if (m && validCats.has(m[1])) {
        state.category = m[1];
        apply();
        if (scroll) scrollToSelf();
      }
    };

    // Same-page rail handoff.
    window.addEventListener("melek:selectCategory", (e) => {
      const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
      if (slug && validCats.has(slug)) {
        state.category = slug;
        apply();
        scrollToSelf();
      }
    });
    window.addEventListener("hashchange", () => selectFromHash(true));

    apply();
    selectFromHash(true);
  });
</script>

<style>
  .pb { --scene-pad: clamp(2rem, 4vw, 3.25rem); scroll-margin-block-start: var(--header-h); overflow: clip; }
  .pb__title { color: var(--scene-title, var(--scene-ink)); margin-block-end: clamp(1.25rem, 3vw, 2rem); }

  .pb__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
  }

  /* Category tabs (shared look with the old .cat-filter chips). */
  .pb__tabs { display: flex; flex-wrap: wrap; gap: 1.25rem; align-items: center; }
  .cat-filter {
    appearance: none;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--scene-ink-dim);
    padding-block-end: 0.3rem;
    border-block-end: 1px solid transparent;
    transition: color 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo);
  }
  .cat-filter:hover { color: var(--scene-ink); }
  .cat-filter.is-active { color: var(--scene-accent); border-block-end-color: var(--scene-accent); }
  .cat-filter:focus-visible { outline: 2px solid var(--scene-accent); outline-offset: 3px; border-radius: 2px; }

  .pb__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }

  /* Search field with a leading icon. */
  .pb__search { position: relative; display: inline-flex; align-items: center; }
  .pb__search-icon { position: absolute; inset-inline-start: 0.85rem; color: var(--scene-ink-dim); pointer-events: none; }
  .pb__input {
    width: clamp(180px, 40vw, 260px);
    padding-inline-start: 2.4rem;
    padding-block: 0.6rem;
    font-size: 0.875rem;
  }

  /* Packaging / Box segmented control. */
  .seg {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--scene-line);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--scene-ink) 4%, transparent);
  }
  .seg__btn {
    appearance: none;
    border: 0;
    cursor: pointer;
    background: transparent;
    color: var(--scene-ink-dim);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.9rem;
    border-radius: 9999px;
    transition: background 0.2s var(--ease-out-expo), color 0.2s var(--ease-out-expo);
  }
  .seg__btn:hover { color: var(--scene-ink); }
  .seg__btn.is-active { background: var(--scene-accent); color: var(--color-emerald-deep); }
  .seg__btn:focus-visible { outline: 2px solid var(--scene-accent); outline-offset: 2px; }

  /* Disabled when the active category has no packaging/box split (e.g. rice, olives). */
  .seg.is-disabled { opacity: 0.4; }
  .seg.is-disabled .seg__btn { cursor: not-allowed; }
  .seg__btn:disabled:hover { color: var(--scene-ink-dim); }

  .pb__empty { padding-block: 2rem; text-align: center; }
  .pb__foot { margin-block-start: clamp(1.5rem, 3vw, 2.25rem); }

  /* --- Product grid: mobile snap-carousel, desktop uniform grid (lifted from
     products/index.astro so the tile look is identical). --- */
  .cat-grid {
    list-style: none; margin: 0; padding: 0 0 1rem;
    display: flex;
    gap: clamp(0.9rem, 3vw, 1.25rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--scene-accent) transparent;
  }
  .cat-grid::-webkit-scrollbar { height: 4px; }
  .cat-grid::-webkit-scrollbar-thumb { background: var(--scene-line); border-radius: 99px; }
  .cat-card { flex: 0 0 auto; inline-size: clamp(150px, 52vw, 210px); scroll-snap-align: start; }
  .cat-card[hidden] { display: none; }

  @media (max-width: 759px) {
    .cat-grid {
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
    }
  }
  @media (min-width: 760px) {
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
      gap: clamp(0.9rem, 2vw, 1.5rem);
      overflow: visible;
      padding-block-end: 0;
    }
    .cat-card { inline-size: auto; scroll-snap-align: none; }
  }

  .cat-card__link { text-decoration: none; color: inherit; display: block; }
  .cat-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--scene-line);
    background:
      radial-gradient(75% 60% at 50% 32%, rgba(0, 48, 12, 0.06), transparent 70%),
      #ffffff;
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 16px 30px -22px rgba(22, 19, 17, 0.22);
  }
  .cat-card__media img {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: contain;
    padding: clamp(1rem, 2vw, 1.5rem);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .cat-card__link:hover .cat-card__media img,
  .cat-card__link:focus-visible .cat-card__media img { transform: scale(1.07); }
  .cat-card__link:focus-visible .cat-card__media { outline: 2px solid var(--scene-accent); outline-offset: 3px; }

  .cat-card__meta { padding-block-start: 0.8rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cat-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem; font-weight: 600; line-height: 1.2;
    color: var(--scene-ink);
    display: block; max-inline-size: 100%;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
</style>
