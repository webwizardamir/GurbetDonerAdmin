---
// dividers=false abuts the panel to its neighbours as flat dark cuts (cinematic homepage).
// Default true keeps the wave dividers for the products pages' bone context.
interface Props { dividers?: boolean; }
const { dividers = true } = Astro.props;
---

{dividers && (
  <div class="dcta-divider-top" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,80 L0,30 C240,72 480,72 720,42 C960,12 1200,12 1440,50 L1440,80 Z" fill="var(--color-emerald-deep)"/>
    </svg>
  </div>
)}

<section class="dcta" aria-labelledby="dcta-title">
  <div class="dcta__bg" aria-hidden="true">
    <div class="dcta__grain"></div>
  </div>
  <div class="container-x dcta__pad">
    <div class="dcta__grid">
      <div class="dcta__content reveal">
        <p class="eyebrow eyebrow--bone">Partner with Melek</p>
        <h2 id="dcta-title" class="text-display dcta__title">
          Already exporting to your market? Let&rsquo;s add a halal range that moves.
        </h2>
        <p class="dcta__lede">
          Tell us about your market, your channels and your volume. We come back with a range
          proposal, indicative pricing and the certificates your buyers will ask for.
        </p>
        <div class="dcta__actions">
          <a href="/distributors/" class="btn btn-primary">
            Open the distributor brief
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/samples/" class="btn btn-secondary-light">Request a sample box</a>
        </div>
      </div>

      <aside class="dcta__aside reveal">
        <ul class="dcta__list">
          <li>
            <span class="dcta__list-num">01</span>
            <div>
              <p class="dcta__list-title">Tell us your market</p>
              <p class="dcta__list-body">Country, channels (Horeca / retail / wholesale), approximate volume.</p>
            </div>
          </li>
          <li>
            <span class="dcta__list-num">02</span>
            <div>
              <p class="dcta__list-title">We propose a range</p>
              <p class="dcta__list-body">Range proposal, indicative pricing, packaging variants, lead times.</p>
            </div>
          </li>
          <li>
            <span class="dcta__list-num">03</span>
            <div>
              <p class="dcta__list-title">Sample &amp; certify</p>
              <p class="dcta__list-body">Sample box, certificates, technical sheets, and the contact for your sales lead.</p>
            </div>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

{dividers && (
  <div class="dcta-divider-bottom" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,0 L0,30 C240,72 480,72 720,42 C960,12 1200,12 1440,50 L1440,0 Z" fill="var(--color-emerald-deep)"/>
    </svg>
  </div>
)}

<style>
  .dcta-divider-top,
  .dcta-divider-bottom { line-height: 0; }
  .dcta-divider-top { background: var(--color-bone); }    /* Process bone above */
  .dcta-divider-bottom { background: var(--color-bone); } /* Certifications bone below */
  .dcta-divider-top svg,
  .dcta-divider-bottom svg {
    display: block;
    inline-size: 100%;
    block-size: clamp(40px, 5vw, 80px);
  }
  .dcta-divider-top svg { margin-block-end: -1px; }
  .dcta-divider-bottom svg { margin-block-start: -1px; }
  .dcta {
    position: relative;
    color: var(--color-bone);
    background: var(--color-emerald-deep);
    isolation: isolate;
    overflow: hidden;
  }
  .dcta__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Flat emerald-deep so wave dividers match seamlessly. Visual interest = grain + content. */
    background: var(--color-emerald-deep);
  }
  .dcta__grain {
    position: absolute;
    inset: 0;
    opacity: 0.06;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }

  .dcta__pad {
    padding-block: clamp(64px, 8vw, 96px) clamp(80px, 10vw, 128px);
  }

  .dcta__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  @media (min-width: 960px) {
    .dcta__grid { grid-template-columns: 6fr 5fr; align-items: start; }
  }

  .dcta__title {
    margin: 0.75rem 0 0;
    color: var(--color-bone);
    max-inline-size: 18ch;
  }
  .dcta__lede {
    margin-block-start: 1.125rem;
    color: rgba(251, 248, 240, 0.78);
    max-inline-size: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .dcta__actions {
    margin-block-start: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .dcta__aside { padding-block-start: 0.5rem; }
  .dcta__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    border-block-start: 1px solid rgba(251, 248, 240, 0.18);
    padding-block-start: 1.25rem;
  }
  .dcta__list li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 0.875rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid rgba(251, 248, 240, 0.12);
  }
  .dcta__list li:last-child { border-block-end: 0; padding-block-end: 0; }
  .dcta__list-num {
    font-family: var(--font-display);
    font-size: 1.125rem;
    color: var(--color-gold-soft);
    letter-spacing: -0.01em;
  }
  .dcta__list-title {
    margin: 0;
    color: var(--color-bone);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: -0.015em;
    font-weight: 500;
  }
  .dcta__list-body {
    margin: 0.25rem 0 0;
    color: rgba(251, 248, 240, 0.74);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
