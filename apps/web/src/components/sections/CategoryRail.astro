---
// Iconized category row, shown directly below the hero. Six tiles (icon + name,
// no counts). Each tile is a real link to /products/#cat-{slug}; on a page that
// already hosts the ProductBrowser (the homepage) a small script intercepts the
// click to select that tab and smooth-scroll instead of navigating.
import { site } from "../../lib/site";
import CategoryIcon from "../CategoryIcon.astro";

interface Props { scene?: string }
const { scene = "light" } = Astro.props;
const cats = site.productCategories;
---

<section class="scene crail" data-scene={scene} aria-label="Product categories">
  <div class="grain grain--dark" aria-hidden="true"></div>
  <div class="container-x">
    <ul class="crail__list">
      {cats.map((c) => (
        <li class="crail__item">
          <a class="crail__tile" href={`/products/#cat-${c.slug}`} data-cat-link={c.slug}>
            <span class="crail__icon" aria-hidden="true"><CategoryIcon slug={c.slug} /></span>
            <span class="crail__name">{c.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Same-page handoff: if the ProductBrowser is on this page, intercept the tile
  // click, select the tab, and let the browser widget handle scroll. Otherwise
  // the anchor navigates to /products/#cat-{slug} where the widget reads the hash.
  const browser = document.getElementById("product-browser");
  if (browser) {
    document.querySelectorAll<HTMLAnchorElement>("[data-cat-link]").forEach((a) => {
      a.addEventListener("click", (e) => {
        const slug = a.dataset.catLink!;
        e.preventDefault();
        history.replaceState(null, "", `#cat-${slug}`);
        window.dispatchEvent(new CustomEvent("melek:selectCategory", { detail: { slug } }));
      });
    });
  }
</script>

<style>
  .crail { --scene-pad: clamp(1.75rem, 4vw, 2.75rem); }

  .crail__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }
  @media (min-width: 720px) {
    .crail__list { grid-template-columns: repeat(6, 1fr); }
  }

  .crail__tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    padding: clamp(1rem, 2vw, 1.4rem) 0.5rem;
    border: 1px solid var(--scene-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 70% at 50% 20%, rgba(0, 48, 12, 0.05), transparent 70%),
      #ffffff;
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 14px 26px -22px rgba(22, 19, 17, 0.2);
    text-decoration: none;
    color: var(--scene-ink);
    transition:
      transform 0.3s var(--ease-out-expo),
      box-shadow 0.3s var(--ease-out-expo),
      border-color 0.3s var(--ease-out-expo);
  }
  .crail__tile:hover,
  .crail__tile:focus-visible {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--scene-accent) 55%, var(--scene-line));
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 20px 34px -22px rgba(0, 48, 12, 0.34);
    outline: none;
  }
  .crail__tile:focus-visible { outline: 2px solid var(--scene-accent); outline-offset: 3px; }

  .crail__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: clamp(38px, 7vw, 46px);
    block-size: clamp(38px, 7vw, 46px);
    border-radius: 9999px;
    color: var(--color-emerald);
    background: color-mix(in srgb, var(--color-emerald) 10%, #ffffff);
  }
  .crail__icon svg { inline-size: 55%; block-size: 55%; }
  .crail__tile:hover .crail__icon { color: var(--color-emerald-deep); }

  .crail__name {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.005em;
    text-align: center;
  }
</style>
