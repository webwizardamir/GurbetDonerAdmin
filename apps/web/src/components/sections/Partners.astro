---
// Scene — Brands we carry. A light "featured partners" lockup: each partner brand sits in a clean
// white card on the snow, so full-colour logos read consistently regardless of their own palette.
// Used on the homepage and the About page. Logos are height-tuned per brand (the Aviko ellipse is
// blockier, the McCain wordmark is wide) so both carry similar optical weight. No links off-site.
// Self-inits its own reveal under a scoped [data-preveal] attribute so it never collides with the
// About page's global [data-reveal] pass.
interface Props {
  scene?: string;
  heading?: string;
  lede?: string;
}
const {
  scene = "light",
  heading = "Brands we carry.",
  lede = "Leading potato and fries brands, stocked and delivered alongside our own halal range.",
} = Astro.props;

const partners = [
  { name: "Aviko", img: "/images/partners/aviko.svg", mod: "aviko" },
  { name: "McCain Foodservice Solutions", img: "/images/partners/mccain.png", mod: "mccain" },
];
---

<section class="scene partners" data-scene={scene} id="partners" aria-labelledby="partners-title">
  <div class={`grain${scene === "light" ? " grain--dark" : ""}`} aria-hidden="true"></div>
  <div class="container-x">
    <header class="partners__head" data-preveal>
      <h2 id="partners-title" class="partners__title text-display">{heading}</h2>
      <p class="partners__lede ink-dim">{lede}</p>
    </header>

    <ul class="partners__grid" aria-label="Partner brands">
      {partners.map((p) => (
        <li class={`p-card p-card--${p.mod}`} data-preveal>
          <img src={p.img} alt={p.name} loading="lazy" decoding="async" />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { revealOnScroll } from "../../lib/motion";
  const partners = document.querySelector<HTMLElement>(".partners");
  if (partners) {
    revealOnScroll(partners.querySelectorAll("[data-preveal]"), { y: 24, stagger: 0.1 });
  }
</script>

<style>
  .partners { --scene-pad: clamp(2.25rem, 4vw, 3.25rem); overflow: clip; }

  /* Header: title, then a short deck beside it on wide viewports so the row is never a narrow
     column against a blank half. */
  .partners__head {
    display: grid;
    gap: 0.75rem clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-block-end: clamp(1.75rem, 3.5vw, 2.75rem);
  }
  @media (min-width: 820px) {
    .partners__head { grid-template-columns: minmax(0, 1fr) minmax(0, 26rem); }
  }
  .partners__title { color: var(--scene-title, var(--scene-ink)); margin: 0; max-inline-size: 18ch; }
  .partners__lede { margin: 0; font-size: var(--text-body-lg); line-height: 1.6; max-inline-size: 44ch; }

  /* Logo cards: white chips on the snow, uniform in size, lifted with a soft emerald shadow. */
  .partners__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  @media (min-width: 640px) {
    .partners__grid { grid-template-columns: repeat(2, 1fr); }
  }

  .p-card {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: clamp(140px, 18vw, 190px);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--scene-line);
    background: #ffffff;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6),
      0 24px 45px -34px rgba(0, 48, 12, 0.4);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-out-expo);
  }
  .p-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6),
      0 34px 60px -34px rgba(0, 48, 12, 0.5);
  }

  .p-card img { inline-size: auto; max-inline-size: 100%; object-fit: contain; }
  /* Height-tuned per brand so the two marks read at a similar visual weight. The Aviko ellipse is
     compact and heavy, the McCain wordmark is wide and light, so McCain is set a touch taller. */
  .p-card--aviko img { block-size: clamp(52px, 7vw, 80px); }
  .p-card--mccain img { block-size: clamp(40px, 5.6vw, 66px); }

  @media (prefers-reduced-motion: reduce) {
    .p-card { transition: none; }
    .p-card:hover { transform: none; }
  }
</style>
