---
import { site } from "../lib/site";
const links = [...site.nav];
---

<div id="mobile-nav" class="mobile-menu" data-mobile-panel data-state="closed" aria-hidden="true">
  <div class="grain grain--dark" aria-hidden="true"></div>
  <div class="mobile-menu__inner">
    <div class="mobile-menu__head">
      <a href="/" class="mobile-menu__brand" data-mm-close>
        <img src="/logo.png" alt={site.fullName} width="259" height="120" />
      </a>
      <button class="mobile-menu__close" type="button" aria-label="Close menu" data-mm-close>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>

    <nav aria-label="Mobile primary">
      <ul class="mobile-menu__list">
        {links.map((item) => (
          <li>
            <a href={item.href} data-mm-close>
              <span class="mobile-menu__label">{item.label}</span>
              <svg class="mobile-menu__arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            {item.href === "/products/" && (
              <ul class="mobile-menu__sublist">
                {site.productCategories.map((c) => (
                  <li>
                    <a href={`/products/#cat-${c.slug}`} data-mm-close>
                      <span class="mobile-menu__sublabel">{c.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu__cta">
      <a href={site.portalUrl} class="btn btn-primary mobile-menu__btn-primary" rel="noopener" data-mm-close>Inloggen</a>
      <a href="/samples/" class="btn btn-secondary mobile-menu__btn-secondary" data-mm-close>Request samples</a>
    </div>

    <div class="mobile-menu__contact">
      <p class="op-label mobile-menu__eyebrow">Get in touch</p>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a>
    </div>

    <div class="mobile-menu__social">
      <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram">Instagram</a>
      <span aria-hidden="true">·</span>
      <a href={site.social.linkedin} rel="noopener" target="_blank" aria-label="LinkedIn">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 70;
    color: var(--color-charcoal);
    /* Light-dominant overlay, matching the homepage: near-white snow warmed with the same soft
       emerald/brass radial glow used on light scenes. */
    background:
      radial-gradient(1000px 460px at 92% -6%, rgba(0, 48, 12, 0.08), transparent 60%),
      radial-gradient(760px 420px at 0% 106%, rgba(169, 221, 114, 0.07), transparent 58%),
      var(--color-snow);
    isolation: isolate;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out-expo);
    overflow-y: auto;
  }
  .mobile-menu[data-state="open"] {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-menu__inner {
    position: relative;
    z-index: 1;
    min-height: 100%;
    padding: 1.25rem var(--gutter) 2.5rem;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .mobile-menu__brand img { height: 38px; width: auto; }
  .mobile-menu__close {
    background: transparent;
    border: 0;
    color: var(--color-charcoal);
    padding: 8px;
    margin-inline-end: -8px;
    cursor: pointer;
    border-radius: var(--radius);
    transition: background 0.2s var(--ease-out-expo);
  }
  .mobile-menu__close:hover { background: rgba(0, 48, 12, 0.08); }

  .mobile-menu__eyebrow { margin-block-start: 1.5rem; color: var(--color-slate-500); }

  .mobile-menu__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(0, 48, 12, 0.12);
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo), padding-inline-start 0.25s var(--ease-out-expo);
  }
  .mobile-menu__list a:hover,
  .mobile-menu__list a:focus-visible { color: var(--color-emerald); padding-inline-start: 6px; }
  .mobile-menu__label {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .mobile-menu__arrow { color: var(--color-emerald); opacity: 0.7; flex-shrink: 0; }

  /* Packaging / Box sub-links under Products. */
  .mobile-menu__sublist { list-style: none; margin: 0; padding: 0 0 0.5rem; }
  .mobile-menu__sublist a {
    display: flex;
    align-items: center;
    padding: 0.55rem 0;
    padding-inline-start: 1rem;
    border-bottom: 1px solid rgba(0, 48, 12, 0.08);
    color: var(--color-slate-700);
    text-decoration: none;
    transition: color 0.2s var(--ease-out-expo), padding-inline-start 0.25s var(--ease-out-expo);
  }
  .mobile-menu__sublist a:hover,
  .mobile-menu__sublist a:focus-visible { color: var(--color-emerald); padding-inline-start: 1.35rem; }
  .mobile-menu__sublabel {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .mobile-menu__cta {
    margin-block-start: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .mobile-menu__btn-primary,
  .mobile-menu__btn-secondary {
    justify-content: center;
    padding-block: 1rem;
    font-size: 0.9375rem;
  }

  .mobile-menu__contact {
    margin-block-start: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .mobile-menu__contact a {
    color: var(--color-slate-700);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-block-start: 0.5rem;
    transition: color 0.2s var(--ease-out-expo);
  }
  .mobile-menu__contact a:hover { color: var(--color-emerald); }

  .mobile-menu__social {
    margin-block-start: auto;
    padding-block-start: 1.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-slate-500);
  }
  .mobile-menu__social a {
    color: var(--color-slate-700);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: border-color 0.2s var(--ease-out-expo);
  }
  .mobile-menu__social a:hover { border-block-end-color: currentColor; }

  body.is-menu-open { overflow: hidden; }
</style>
