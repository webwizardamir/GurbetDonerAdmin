---
/**
 * Decoy + timing fields for the public forms. Pair with `mountPublicForm`
 * from `src/lib/formGuard.ts`, which reads them on submit.
 *
 * The honeypots carry real labels and plausible names so a naive bot fills them
 * in, but they are pulled off-canvas, removed from the tab order and hidden from
 * assistive tech, so no visitor ever meets them. They are deliberately NOT
 * `display: none`: some scrapers skip those, and some browsers skip submitting
 * them.
 *
 * `idPrefix` keeps the ids unique when a page ever renders two forms.
 */
import { HONEYPOT_FIELDS, TIMESTAMP_FIELD } from "../lib/formGuard";

interface Props {
  idPrefix?: string;
}

const { idPrefix = "fg" } = Astro.props;
---

<div class="fg-trap" aria-hidden="true">
  <label for={`${idPrefix}-${HONEYPOT_FIELDS[0]}`}>Website</label>
  <input
    id={`${idPrefix}-${HONEYPOT_FIELDS[0]}`}
    name={HONEYPOT_FIELDS[0]}
    type="text"
    tabindex="-1"
    autocomplete="off"
  />
  <label for={`${idPrefix}-${HONEYPOT_FIELDS[1]}`}>Fax number</label>
  <input
    id={`${idPrefix}-${HONEYPOT_FIELDS[1]}`}
    name={HONEYPOT_FIELDS[1]}
    type="text"
    tabindex="-1"
    autocomplete="off"
  />
</div>
<input type="hidden" name={TIMESTAMP_FIELD} value="" />

<style>
  .fg-trap {
    position: absolute;
    inset-inline-start: -9999px;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
</style>
