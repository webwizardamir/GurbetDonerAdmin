---
/**
 * A mail link that address harvesters cannot read off the page.
 *
 * The spam arriving at info@ is scraped, not submitted: the address used to sit
 * in plain text in the footer, the mobile menu, the export CTA and the contact
 * page, on every single page of the site. Harvesters regex the HTML for
 * `something@something.tld`, so the fix is to make sure that string is never in
 * the markup.
 *
 * What ships in the HTML: a base64 blob in a data attribute, a link to /contact/
 * and the address written as "info [at] domain". What a visitor gets: JS swaps in
 * the real `mailto:` and the real text on load. With JS off the link still works,
 * it just goes to the contact page, and the address is still readable by eye.
 *
 * This stops the naive bulk harvesters, which is nearly all of them. It is not a
 * defence against someone deliberately targeting this site, and it cannot be:
 * anything a browser can render, a determined scraper can render too.
 */
interface Props {
  /** Full address, e.g. `info@melekhalalfood.nl`. */
  address: string;
  /** Class list for the anchor. */
  class?: string;
  /** Show this text instead of the address (the href is still upgraded). */
  label?: string;
}

const { address, class: className, label } = Astro.props;

const [user, domain] = address.split("@");
const encoded = Buffer.from(address, "utf8").toString("base64");
---

<a
  href="/contact/"
  class={className}
  rel="nofollow"
  data-e={encoded}
  data-e-keep={label ? "" : undefined}
>{label ?? `${user} [at] ${domain}`}</a>

<script>
  /**
   * Upgrade every obfuscated mail link once, on load. Runs a single time no
   * matter how many instances the page renders (Astro hoists this module).
   */
  for (const a of document.querySelectorAll<HTMLAnchorElement>("a[data-e]")) {
    const encoded = a.dataset.e;
    if (!encoded) continue;
    let address = "";
    try {
      address = atob(encoded);
    } catch {
      continue;
    }
    a.href = `mailto:${address}`;
    if (!a.hasAttribute("data-e-keep")) a.textContent = address;
    a.removeAttribute("data-e");
  }
</script>
