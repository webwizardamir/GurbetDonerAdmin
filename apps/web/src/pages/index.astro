---
import Base from "../layouts/Base.astro";
import Hero from "../components/sections/Hero.astro";
import CategoryRail from "../components/sections/CategoryRail.astro";
import CertMarquee from "../components/sections/CertMarquee.astro";
import ProductionStory from "../components/sections/ProductionStory.astro";
import ProductBrowser from "../components/sections/ProductBrowser.astro";
import Partners from "../components/sections/Partners.astro";
import ExportCTA from "../components/sections/ExportCTA.astro";
---

<Base bodyClass="has-dark-hero">
  <Hero />
  <CategoryRail scene="light" />
  <CertMarquee />
  <ProductionStory scene="light" />
  <ProductBrowser id="product-browser" scene="light" heading="Browse the range." showAllLink={true} showAllTab={false} />
  <Partners scene="light" />
  <ExportCTA />
</Base>

<script>
  import { initSmoothScroll } from "../lib/motion";
  initSmoothScroll();
</script>
