---
import Base from "../../layouts/Base.astro";
import ExportCTA from "../../components/sections/ExportCTA.astro";
import { getCollection } from "astro:content";
import { site } from "../../lib/site";

type ProductData = {
  name: string;
  category: "chicken" | "beef" | "snacks";
  weight?: string;
  tagline?: string;
  image?: string;
};

type RelatedItem = { id: string; name: string; category: string; weight?: string; image?: string };

export async function getStaticPaths() {
  const all = await getCollection("products");
  return all.map((p) => ({
    params: { slug: p.id },
    props: { data: p.data as ProductData, allProducts: all.map((q) => ({ id: q.id, ...q.data })) },
  }));
}

const { data, allProducts } = Astro.props;
const slug = Astro.params.slug;
const cat = site.productCategories.find((c) => c.slug === data.category);

const related: RelatedItem[] = (allProducts as Array<{ id: string } & ProductData>)
  .filter((p) => p.category === data.category && p.id !== slug && p.image)
  .slice(0, 4)
  .map((p) => ({ id: p.id, name: p.name, category: p.category, weight: p.weight, image: p.image }));

const facts = [
  { k: "Unit weight", v: data.weight ?? "On request" },
  { k: "Certification", v: "Halal · BRC · IFS" },
  { k: "Packaging", v: "Retail and Horeca cases on request" },
];
---

<Base
  title={data.name}
  description={data.tagline ?? `Halal ${data.name}.`}
  bodyClass="page-light"
>
  <article class="scene pd" data-scene="light">
    <div class="grain grain--dark" aria-hidden="true"></div>
    <div class="container-x">
      <nav class="pd__crumbs op-label" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href="/products/">Products</a>
        {cat && (<><span aria-hidden="true">/</span><a href={`/products/#${cat.slug}`}>{cat.name}</a></>)}
        <span aria-hidden="true">/</span>
        <span class="pd__crumb-current" aria-current="page">{data.name}</span>
      </nav>

      <div class="pd__grid">
        <figure class="pd__media">
          {data.image
            ? <img src={data.image} alt={data.name} loading="eager" />
            : <span class="pd__placeholder font-x">{data.name.split(" ").map((w) => w[0]).slice(0, 2).join("")}</span>}
        </figure>

        <div class="pd__body">
          <h1 class="pd__title text-hero">{data.name}</h1>
          {data.tagline && <p class="pd__tag ink-dim">{data.tagline}</p>}

          <dl class="pd__facts">
            {facts.map((f) => (
              <div class="pd__fact">
                <dt class="op-label ink-dim">{f.k}</dt>
                <dd class="pd__fact-val">{f.v}</dd>
              </div>
            ))}
          </dl>

          <div class="pd__actions">
            <a href={`/samples/?product=${encodeURIComponent(data.name)}`} class="btn btn-primary">
              Request a sample
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            <a href="/contact/" class="btn btn-secondary">Request a quote</a>
          </div>

          <p class="op-label ink-dim pd__note">Full spec sheet, nutrition table and case-pack details on request.</p>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <div class="container-x pd__related">
        <header class="pd__related-head">
          <h2 class="pd__related-title text-display">More from {cat?.name.toLowerCase() ?? "the range"}.</h2>
          <a href={`/products/#${cat?.slug ?? ""}`} class="op-label text-accent pd__related-all">View all {cat?.name.toLowerCase()}</a>
        </header>
        <ul class="cat-grid">
          {related.map((p) => (
            <li class="cat-card" data-reveal>
              <a class="cat-card__link" href={`/products/${p.id}/`}>
                <div class="cat-card__media"><img src={p.image} alt={p.name} loading="lazy" decoding="async" /></div>
                <div class="cat-card__meta">
                  <span class="op-label ink-dim">{cat?.name}{p.weight ? ` · ${p.weight}` : ""}</span>
                  <span class="cat-card__name" title={p.name}>{p.name}</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>

  <ExportCTA />
</Base>

<script>
  import { revealOnScroll, initSmoothScroll } from "../../lib/motion";
  initSmoothScroll();
  revealOnScroll(document.querySelectorAll(".pd__related [data-reveal]"), { y: 24, stagger: 0.05 });
</script>

<style>
  .pd { --scene-pad: 0; padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(3rem, 6vw, 5rem); }

  .pd__crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--scene-ink-dim); margin-block-end: clamp(1.5rem, 4vw, 2.5rem); }
  .pd__crumbs a { color: var(--scene-ink-dim); text-decoration: none; transition: color 0.2s var(--ease-out-expo); }
  .pd__crumbs a:hover { color: var(--scene-accent); }
  .pd__crumb-current { color: var(--scene-ink); }

  .pd__grid { display: grid; grid-template-columns: 1fr; gap: clamp(2rem, 5vw, 4rem); }
  @media (min-width: 900px) { .pd__grid { grid-template-columns: 6fr 5fr; align-items: start; } }

  .pd__media {
    margin: 0;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--scene-line);
    /* White presentation tile with a faint emerald wash + soft lift (light system). */
    background:
      radial-gradient(70% 60% at 50% 38%, rgba(0, 48, 12, 0.06), transparent 70%),
      #ffffff;
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 26px 50px -34px rgba(0, 48, 12, 0.3);
    display: flex; align-items: center; justify-content: center;
  }
  .pd__media img {
    inline-size: 82%; block-size: 82%; object-fit: contain;
    filter: drop-shadow(0 22px 30px rgba(22, 19, 17, 0.18));
  }
  .pd__placeholder { font-size: clamp(4rem, 10vw, 7rem); font-weight: 800; color: rgba(0, 48, 12, 0.14); }

  .pd__title { color: var(--scene-title, var(--scene-ink)); margin-block-start: 0.6rem; }
  .pd__tag { margin-block-start: 1rem; max-inline-size: 46ch; font-size: var(--text-body-lg); line-height: 1.6; }

  .pd__facts { margin: clamp(1.75rem, 3vw, 2.25rem) 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .pd__fact {
    display: flex; flex-direction: column; gap: 0.4rem;
    padding: 1rem 0;
    border-block-start: 1px solid var(--scene-line);
  }
  .pd__fact:nth-child(odd) { padding-inline-end: 1.25rem; }
  .pd__fact:nth-child(even) { padding-inline-start: 1.25rem; border-inline-start: 1px solid var(--scene-line); }
  .pd__fact-val { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; color: var(--scene-ink); line-height: 1.2; }

  .pd__actions { margin-block-start: clamp(1.75rem, 3vw, 2.25rem); display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .pd__note { margin-block-start: 1.5rem; }

  /* Related */
  .pd__related { margin-block-start: clamp(3.5rem, 7vw, 6rem); padding-block-start: clamp(2rem, 4vw, 3rem); border-block-start: 1px solid var(--scene-line); }
  .pd__related-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-block-end: clamp(1.5rem, 3vw, 2rem); }
  .pd__related-title { color: var(--scene-title, var(--scene-ink)); }
  .pd__related-all { text-decoration: none; }
  .pd__related-all:hover { text-decoration: underline; }

  /* Reuse the catalog tile look (carousel on mobile, grid on desktop). */
  .cat-grid {
    list-style: none; margin: 0; padding: 0 0 1rem;
    display: flex; gap: clamp(0.9rem, 3vw, 1.25rem);
    overflow-x: auto; scroll-snap-type: x proximity;
    scrollbar-width: thin; scrollbar-color: var(--scene-accent) transparent;
  }
  .cat-grid::-webkit-scrollbar { height: 4px; }
  .cat-grid::-webkit-scrollbar-thumb { background: var(--scene-line); border-radius: 99px; }
  .cat-card { flex: 0 0 auto; inline-size: clamp(150px, 52vw, 210px); scroll-snap-align: start; }
  @media (max-width: 759px) {
    .cat-grid {
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
    }
  }
  @media (min-width: 760px) {
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: clamp(0.9rem, 2vw, 1.5rem); overflow: visible; padding-block-end: 0; }
    .cat-card { inline-size: auto; scroll-snap-align: none; }
  }
  .cat-card__link { text-decoration: none; color: inherit; display: block; }
  .cat-card__media {
    position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid var(--scene-line);
    background: radial-gradient(75% 60% at 50% 32%, rgba(0, 48, 12, 0.06), transparent 70%), #ffffff;
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 16px 30px -22px rgba(22, 19, 17, 0.22);
  }
  .cat-card__media img { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: contain; padding: clamp(1rem, 2vw, 1.5rem); transition: transform 0.6s var(--ease-out-expo); }
  .cat-card__link:hover .cat-card__media img, .cat-card__link:focus-visible .cat-card__media img { transform: scale(1.07); }
  .cat-card__link:focus-visible .cat-card__media { outline: 2px solid var(--scene-accent); outline-offset: 3px; }
  .cat-card__meta { padding-block-start: 0.8rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cat-card__name { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; line-height: 1.2; color: var(--scene-ink); display: block; max-inline-size: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
