---
import Base from "../../layouts/Base.astro";
import ProductBrowser from "../../components/sections/ProductBrowser.astro";
import ExportCTA from "../../components/sections/ExportCTA.astro";
---

<Base
  title="Products"
  description="Halal frozen meat, chicken, snacks, rice and olives. Built for foodservice and retail buyers across Europe."
  bodyClass="page-light"
>
  <!-- Catalog hero -->
  <section class="scene cat-hero" data-scene="light" aria-labelledby="cat-hero-title">
    <div class="grain grain--dark" aria-hidden="true"></div>
    <div class="container-x cat-hero__grid grid-ed grid-ed--7-5">
      <div>
        <h1 id="cat-hero-title" class="cat-hero__title text-hero">Our products.</h1>
        <p class="cat-hero__lede ink-dim">
          Halal meat, chicken, snacks, rice and olives, shipped across Europe.
        </p>
      </div>

      <div class="cat-hero__aside">
        <ul class="cat-hero__facts">
          <li><span class="op-label text-accent">Halal · BRC · IFS</span><span class="ink-dim">Certified</span></li>
          <li><span class="op-label text-accent">Across Europe</span><span class="ink-dim">Shipped to distributors and shops</span></li>
        </ul>
        <a href="/distributors/" class="btn btn-primary cat-hero__cta">
          Request the full catalogue
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <ProductBrowser id="product-browser" scene="light" />

  <ExportCTA />
</Base>

<style>
  /* Catalog hero. main reserves the fixed-header height on light pages, so just add breathing room. */
  .cat-hero { --scene-pad: 0; padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2.5rem); }
  .cat-hero__grid { align-items: end; }
  .cat-hero__title { color: var(--scene-title, var(--scene-ink)); margin-block-start: 0.6rem; max-inline-size: 12ch; }
  .cat-hero__lede { margin-block-start: 1.1rem; max-inline-size: 46ch; font-size: var(--text-body-lg); line-height: 1.6; }

  .cat-hero__aside { display: flex; flex-direction: column; gap: 1.5rem; }
  .cat-hero__facts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .cat-hero__facts li {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding-block-start: 0.9rem; border-block-start: 1px solid var(--scene-line);
  }
  .cat-hero__facts li:first-child { padding-block-start: 0; border-block-start: 0; }
  .cat-hero__facts li span:last-child { font-size: 0.9rem; line-height: 1.4; }
  .cat-hero__cta { align-self: flex-start; }
</style>
