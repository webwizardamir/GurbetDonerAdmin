---
import Base from "../../layouts/Base.astro";
import ExportCTA from "../../components/sections/ExportCTA.astro";
import { site } from "../../lib/site";
import { getCollection } from "astro:content";

type Item = { id: string; name: string; category: string; weight?: string; image?: string; order: number };

let products: Item[] = [];
try {
  const all = await getCollection("products");
  products = all
    .map((p) => ({
      id: p.id,
      name: p.data.name,
      category: p.data.category,
      weight: p.data.weight,
      image: p.data.image,
      order: p.data.order ?? 100,
    }))
    .filter((p) => p.image)
    .sort((a, b) => a.order - b.order);
} catch {}

const grouped = site.productCategories.map((c) => ({
  ...c,
  items: products.filter((p) => p.category === c.slug),
}));
---

<Base
  title="Products"
  description="Halal frozen chicken, beef and snacks. Built for foodservice and retail buyers across Europe."
  bodyClass="page-light"
>
  <!-- Catalog hero -->
  <section class="scene cat-hero" data-scene="light" aria-labelledby="cat-hero-title">
    <div class="grain grain--dark" aria-hidden="true"></div>
    <div class="container-x cat-hero__grid grid-ed grid-ed--7-5">
      <div>
        <h1 id="cat-hero-title" class="cat-hero__title text-hero">Our products.</h1>
        <p class="cat-hero__lede ink-dim">
          Halal chicken, beef and snacks, shipped across Europe.
        </p>
        <nav class="cat-hero__filter" aria-label="Jump to range">
          <a href="#all" class="cat-filter is-active" data-filter="all">All</a>
          {site.productCategories.map((c) => (
            <a href={`#${c.slug}`} class="cat-filter" data-filter={c.slug}>{c.name}</a>
          ))}
        </nav>
      </div>

      <div class="cat-hero__aside">
        <ul class="cat-hero__facts">
          <li><span class="op-label text-accent">Halal · BRC · IFS</span><span class="ink-dim">Certified</span></li>
          <li><span class="op-label text-accent">Across Europe</span><span class="ink-dim">Shipped to distributors and shops</span></li>
        </ul>
        <a href="/distributors/" class="btn btn-primary cat-hero__cta">
          Request the full catalogue
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <div id="all" class="cat-anchor" aria-hidden="true"></div>

  {grouped.map((g) => (
    <section
      id={g.slug}
      class="scene cat-range"
      data-scene="light"
      aria-labelledby={`cat-${g.slug}`}
    >
      <div class="grain grain--dark" aria-hidden="true"></div>
      <div class="container-x">
        <header class="cat-range__head">
          <h2 id={`cat-${g.slug}`} class="cat-range__name font-x">{g.name}</h2>
          <p class="cat-range__desc ink-dim">{g.description}</p>
        </header>

        {g.items.length === 0 ? (
          <p class="cat-empty ink-dim">Coming soon.</p>
        ) : (
          <ul class="cat-grid">
            {g.items.map((p) => (
              <li class="cat-card" data-reveal>
                <a class="cat-card__link" href={`/products/${p.id}/`}>
                  <div class="cat-card__media">
                    <img src={p.image} alt={p.name} loading="lazy" decoding="async" />
                  </div>
                  <div class="cat-card__meta">
                    <span class="op-label ink-dim">{g.name}{p.weight ? ` · ${p.weight}` : ""}</span>
                    <span class="cat-card__name" title={p.name}>{p.name}</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  ))}

  <ExportCTA />
</Base>

<script>
  import { revealOnScroll, initSmoothScroll } from "../../lib/motion";
  initSmoothScroll();
  revealOnScroll(document.querySelectorAll(".cat-range [data-reveal]"), { y: 26, stagger: 0.03 });

  const chips = document.querySelectorAll<HTMLAnchorElement>(".cat-filter");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.classList.remove("is-active"));
      chip.classList.add("is-active");
    });
  });
</script>

<style>
  /* Catalog hero. main reserves the fixed-header height on light pages, so just add breathing room. */
  .cat-hero { --scene-pad: 0; padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3.25rem); }
  .cat-hero__grid { align-items: end; }
  .cat-hero__title { color: var(--scene-title, var(--scene-ink)); margin-block-start: 0.6rem; max-inline-size: 12ch; }
  .cat-hero__lede { margin-block-start: 1.1rem; max-inline-size: 46ch; font-size: var(--text-body-lg); line-height: 1.6; }

  .cat-hero__filter {
    margin-block-start: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
  }
  .cat-filter {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--scene-ink-dim);
    text-decoration: none;
    padding-block-end: 0.3rem;
    border-block-end: 1px solid transparent;
    transition: color 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo);
  }
  .cat-filter:hover { color: var(--scene-ink); }
  .cat-filter.is-active { color: var(--scene-accent); border-block-end-color: var(--scene-accent); }

  .cat-hero__aside { display: flex; flex-direction: column; gap: 1.5rem; }
  .cat-hero__facts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .cat-hero__facts li {
    display: flex; flex-direction: column; gap: 0.2rem;
    padding-block-start: 0.9rem; border-block-start: 1px solid var(--scene-line);
  }
  .cat-hero__facts li:first-child { padding-block-start: 0; border-block-start: 0; }
  .cat-hero__facts li span:last-child { font-size: 0.9rem; line-height: 1.4; }
  .cat-hero__cta { align-self: flex-start; }

  /* Offset anchor jumps so the fixed header does not cover the range heading. */
  .cat-anchor { position: relative; }
  .cat-range { scroll-margin-block-start: var(--header-h); }
  .cat-range { --scene-pad: clamp(2rem, 4vw, 3.25rem); }

  .cat-range__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
  }
  .cat-range__name {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 0.85;
    color: var(--scene-title, var(--scene-ink));
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .cat-range__desc { font-size: 0.95rem; line-height: 1.55; max-inline-size: 46ch; }
  .cat-empty { padding-block: 1.5rem; }

  /* Mobile: horizontal carousel (a 46-tile vertical grid is too long to scroll on a phone).
     Desktop (>=760px): the uniform grid. */
  .cat-grid {
    list-style: none; margin: 0; padding: 0 0 1rem;
    display: flex;
    gap: clamp(0.9rem, 3vw, 1.25rem);
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--scene-accent) transparent;
  }
  .cat-grid::-webkit-scrollbar { height: 4px; }
  .cat-grid::-webkit-scrollbar-thumb { background: var(--scene-line); border-radius: 99px; }
  .cat-card { flex: 0 0 auto; inline-size: clamp(150px, 52vw, 210px); scroll-snap-align: start; }

  /* Mobile carousel: fade the right edge so the peeking card signals "more to swipe". */
  @media (max-width: 759px) {
    .cat-grid {
      -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(90deg, #000 calc(100% - 48px), transparent);
    }
  }

  @media (min-width: 760px) {
    .cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr));
      gap: clamp(0.9rem, 2vw, 1.5rem);
      overflow: visible;
      padding-block-end: 0;
    }
    .cat-card { inline-size: auto; scroll-snap-align: none; }
  }

  .cat-card__link { text-decoration: none; color: inherit; display: block; }
  .cat-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--scene-line);
    /* White tile with a faint emerald wash + soft lift, matching the homepage light tiles. */
    background:
      radial-gradient(75% 60% at 50% 32%, rgba(0, 48, 12, 0.06), transparent 70%),
      #ffffff;
    box-shadow: 0 1px 0 rgba(22, 19, 17, 0.03), 0 16px 30px -22px rgba(22, 19, 17, 0.22);
  }
  .cat-card__media img {
    position: absolute; inset: 0;
    inline-size: 100%; block-size: 100%;
    object-fit: contain;
    padding: clamp(1rem, 2vw, 1.5rem);
    transition: transform 0.6s var(--ease-out-expo);
  }
  .cat-card__link:hover .cat-card__media img,
  .cat-card__link:focus-visible .cat-card__media img { transform: scale(1.07); }
  .cat-card__link:focus-visible .cat-card__media { outline: 2px solid var(--scene-accent); outline-offset: 3px; }

  .cat-card__meta { padding-block-start: 0.8rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .cat-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem; font-weight: 600; line-height: 1.2;
    color: var(--scene-ink);
    display: block; max-inline-size: 100%;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
</style>
