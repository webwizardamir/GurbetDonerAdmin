# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# App Configuration
VITE_APP_NAME=MelekHalalFood B2B Portal
VITE_API_URL=http://localhost:5173

# Which tenant this build is for: melek (default) | father
# Drives app name, logo, brand color and feature switches -- see src/config/tenant.ts.
# The father deployment ALSO needs its own VITE_SUPABASE_URL / ANON_KEY above
# (separate Supabase project, no shared data). Leave unset for Melek.
VITE_TENANT=melek
